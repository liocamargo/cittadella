rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(bibliotecaId) {
      return signedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/Bibliotecas/$(bibliotecaId)).data.miembrosUids;
    }

    function isInvitedTo(biblioteca) {
      return signedIn() &&
        request.auth.token.email in biblioteca.data.invitacionesPendientes;
    }

    // Catálogo comunitario de libros, indexado por ISBN. Lectura pública
    // (permite links de solo lectura y ver ratings/dueños antes de loguearse).
    // Escritura: cualquier usuario logueado puede crear o enriquecer un libro
    // (p.ej. al escanear un ISBN nuevo).
    match /Libros_Globales/{isbn} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;

      match /resenas/{resenaId} {
        allow read: if true;
        allow create: if signedIn() &&
          request.resource.data.usuarioUid == request.auth.uid;
        allow update, delete: if signedIn() &&
          resource.data.usuarioUid == request.auth.uid;
      }
    }

    // Espacios colaborativos. Solo los miembros pueden leer/escribir la
    // biblioteca; cualquier usuario logueado puede crear una nueva
    // agregándose a sí mismo como miembro. Un usuario invitado por email
    // (todavía no es miembro) puede leer/actualizar el doc únicamente para
    // auto-aceptar la invitación (ver aceptarInvitacionesPendientes). El
    // documento completo NUNCA es de lectura pública: incluye emails y
    // WhatsApp de todos los miembros e invitaciones pendientes. La página
    // pública /compartido/{id} se sirve vía /api/catalogo/{id} (Admin SDK),
    // que expone solo una proyección segura (nombre y contacto del dueño).
    match /Bibliotecas/{bibliotecaId} {
      allow read: if signedIn() &&
        (request.auth.uid in resource.data.miembrosUids || isInvitedTo(resource));
      allow update: if signedIn() &&
        (request.auth.uid in resource.data.miembrosUids || isInvitedTo(resource));
      allow delete: if signedIn() && request.auth.uid in resource.data.miembrosUids;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.miembrosUids &&
        request.resource.data.creadaPor == request.auth.uid;
    }

    // Inventario físico: solo los miembros pueden leer/escribir. Incluye
    // notas privadas y a quién se le prestó cada copia, así que tampoco es
    // de lectura pública ni siquiera con catalogoPublico=true (ver
    // /api/catalogo/{id} para la proyección pública segura).
    match /Libros_En_Biblioteca/{copiaId} {
      allow read: if isMemberOf(resource.data.bibliotecaId);
      allow update, delete: if isMemberOf(resource.data.bibliotecaId);
      allow create: if isMemberOf(request.resource.data.bibliotecaId);
    }

    // Objetivo personal de lectura: solo el propio usuario (doc id = uid).
    match /MetasLectura/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Libros leídos por un usuario (los tenga en su biblioteca o no).
    // Doc id = `${uid}_${isbn}`, pero igual validamos por campo uid.
    match /Lecturas/{lecturaId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Preferencias personales (idioma de la página / de lectura). Doc id = uid.
    match /Perfiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Base de socios de una biblioteca (modo socios en Préstamos).
    match /Socios/{socioId} {
      allow read: if isMemberOf(resource.data.bibliotecaId);
      allow update, delete: if isMemberOf(resource.data.bibliotecaId);
      allow create: if isMemberOf(request.resource.data.bibliotecaId);
    }

    // Historial de préstamos (para el detalle de cada socio y, a futuro,
    // estadísticas). Se crea al prestar y se completa al devolver.
    match /HistorialPrestamos/{historialId} {
      allow read: if isMemberOf(resource.data.bibliotecaId);
      allow update: if isMemberOf(resource.data.bibliotecaId);
      allow create: if isMemberOf(request.resource.data.bibliotecaId);
      // Solo para limpiar el historial de una biblioteca que se borra
      // entera (ver eliminarDatosDeCuenta).
      allow delete: if isMemberOf(resource.data.bibliotecaId);
    }
  }
}
