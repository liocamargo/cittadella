# Config de tu proyecto Firebase (Firebase Console > Project Settings > General > Tus apps > SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pública del sitio (usada para el link de acceso por email). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional pero recomendado: sin esta key, Google Books API comparte una
# cuota anónima muy chica (a veces 0) entre todo internet y falla seguido
# con error 429. Con una key propia (gratis) el límite sube a ~1000/día.
# Cómo conseguirla: Google Cloud Console > tu proyecto (podés usar el mismo
# de Firebase) > APIs & Services > Library > "Books API" > Enable >
# Credentials > Create Credentials > API Key.
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Requerido para que "Invitar a un nuevo miembro" (Espacio compartido) mande
# un email de verdad. Se usa server-side (API route /api/invitar), nunca se
# expone al browser — por eso NO lleva el prefijo NEXT_PUBLIC_.
# Cómo conseguirla: creá una cuenta gratis en https://resend.com > API Keys
# > Create API Key.
RESEND_API_KEY=

# Opcional: remitente del email de invitación. Sin verificar un dominio
# propio en Resend, usá el remitente de pruebas que te da Resend
# (onboarding@resend.dev funciona pero puede caer en spam). Si verificás tu
# dominio en Resend, poné algo como "Cittadella <invitaciones@tudominio.com>".
RESEND_FROM_EMAIL=Cittadella <onboarding@resend.dev>
