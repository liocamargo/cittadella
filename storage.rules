rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Portadas de libros: lectura pública (se muestran en el catálogo
    // público /compartido/{id}), escritura solo de usuarios logueados y
    // limitada a imágenes chicas para no gastar de más.
    match /portadas/{isbn}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Archivos EPUB/PDF de los libros de una biblioteca: a diferencia de las
    // portadas, nunca son de lectura pública (mismo criterio que
    // Libros_En_Biblioteca en firestore.rules) — solo los miembros de esa
    // biblioteca pueden leerlos o subirlos.
    match /libros/{bibliotecaId}/{archivo} {
      function esMiembroDeBiblioteca() {
        return request.auth != null &&
          request.auth.uid in
            firestore.get(/databases/(default)/documents/Bibliotecas/$(bibliotecaId)).data.miembrosUids;
      }
      allow read: if esMiembroDeBiblioteca();
      allow write: if esMiembroDeBiblioteca() &&
        request.resource.size < 60 * 1024 * 1024 &&
        request.resource.contentType.matches('application/epub[+]zip|application/pdf');
    }
  }
}
